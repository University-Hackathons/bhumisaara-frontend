# ─────────────────────────────────────────────────────────────────────────────
# BhumiSaara — frontend environment template
#
# Copy this file to `.env.development` and fill in your own values. `.env*` is
# gitignored; this template is the only env file committed, and it contains no
# real credentials.
#
#   cp Example.env .env.development
#
# Every variable is NEXT_PUBLIC_*, so all three are inlined into the client
# bundle at build time. None of them is a secret: the thirdweb client ID is a
# public, domain-restricted identifier, and the contract address is public
# on-chain data. There is no thirdweb secret key anywhere in this project —
# the app never signs on the server.
# ─────────────────────────────────────────────────────────────────────────────

# thirdweb client ID from https://thirdweb.com/dashboard (Settings → API Keys).
# Free tier is sufficient. Add http://localhost:3000 to the key's allowed
# domains or every RPC call is rejected.
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your_thirdweb_client_id

# Address of the deployed ERC-1155 Edition contract on Polygon Amoy.
# The chain itself is not env-driven — it is pinned to polygonAmoy in
# lib/contract.ts, so this address must be an Amoy deployment.
#
# The judging deployment used by the demo video is:
#   0xf380E66166F01b99fe7dd6bAd8afC351f2De2e31
# You may reuse it, or deploy your own Edition (ERC-1155) contract from the
# thirdweb dashboard and paste its address here.
NEXT_PUBLIC_CONTRACT_ADDRESS=0xf380E66166F01b99fe7dd6bAd8afC351f2De2e31

# Base URL of the Spring Boot API, including the /api/v1 context path.
# Must include the version — utils/apiPaths.ts entries are version-free.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
